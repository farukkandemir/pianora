{
  "expo": {
    "name": "piano.learn",
    "slug": "PianoLearn",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon-light.png",
    "scheme": "pianolearn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "bundleIdentifier": "com.farukkandemir.pianolearn",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "PianoLearn uses Bluetooth to connect to your MIDI piano."
      },
      "appleTeamId": "KHAU274LWD"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6A4C7C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-light.png",
          "imageWidth": 160,
          "backgroundColor": "#FDF9F6",
          "dark": {
            "image": "./assets/images/icon-dark.png",
            "backgroundColor": "#1B2331"
          }
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
